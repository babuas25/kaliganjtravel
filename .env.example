# Core application services (copy this file to .env.local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# FirstTrip supplier account
FIRSTTRIP_SEARCH_BASE_URL=
FIRSTTRIP_BASE_URL=
FIRSTTRIP_EMAIL=
FIRSTTRIP_PASSWORD=

# TakeOff supplier account
TAKEOFF_SEARCH_BASE_URL=
TAKEOFF_BASE_URL=
TAKEOFF_EMAIL=
TAKEOFF_PASSWORD=

# Direct Triplover supplier account
TRIPLOVER_SEARCH_BASE_URL=
TRIPLOVER_BASE_URL=
TRIPLOVER_EMAIL=
TRIPLOVER_PASSWORD=

# Shapontravels machine API (server-only; read operations are integrated separately)
# Alternatively use CLIENT_ID and CLIENT_SECRET; prefixed credentials take precedence.
# On Vercel Preview, scope these to the development branch (see docs/29-SHAPONTRAVELS-READ-ONLY-GUIDE.md).
SHAPONTRAVELS_SEARCH_BASE_URL=
SHAPONTRAVELS_CLIENT_ID=
SHAPONTRAVELS_CLIENT_SECRET=

# Shared Redis Cloud authority for temporary Search -> RePrice -> Prepare
# supplier references. Keep this server-only; never use NEXT_PUBLIC_ for it.
REDIS_URL=
FLIGHT_QUOTE_STORE=redis
FLIGHT_QUOTE_TTL_SECONDS=1200
FLIGHT_QUOTE_MAX_BYTES=262144

# The active supplier plus booking/ticketing controls are managed by Super Admin
# in the database. Do not add operational supplier switches to this file.

# BulkSMSBD issued-ticket confirmations for B2B partners. Keep the API key server-only.
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# Optional; the application defaults to https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_URL=

# Kaliganj Travels SMTP. Leave unset until the new mail account is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Kaliganj Travels
EMAIL_REPLY_TO=
# Optional single hidden archive address. Empty means no archive copy.
SYSTEM_EMAIL_BCC=

# New company Cloudinary environment; uploads use kaliganj-travels/... folders.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Super Admin pages. Set either to true and restart/redeploy to enable.
SUPERADMIN_SYSTEM_REPORTS_ENABLED=false
SUPERADMIN_SEARCH_CONTROL_ENABLED=false
